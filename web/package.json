{
  "name": "quizme-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:migrate",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/migrate.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --coverage --coverage.reportsDirectory=coverage/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "drizzle-orm": "0.45.4",
    "fastest-levenshtein": "1.0.16",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
