# Copy to .env for local development. Never commit .env.
# Every value below is a placeholder.

# --- Database (docker-compose provides Postgres on localhost:5432) ---
# Generate each with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-admin
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_APP_PASSWORD=change-me-app
# Used by `npm run dev` on the host. docker-compose builds these itself.
# Runtime role: DML only on application tables.
DATABASE_URL=postgres://quizme_app:change-me-app@localhost:5432/quizme
# Migration role: owns the schema, used only when the container starts.
MIGRATION_DATABASE_URL=postgres://quizme_migrator:change-me-migrator@localhost:5432/quizme

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=<your-google-client-id>
AUTH_GOOGLE_SECRET=<your-google-client-secret>
AUTH_MICROSOFT_ENTRA_ID_ID=<your-entra-application-client-id>
AUTH_MICROSOFT_ENTRA_ID_SECRET=<your-entra-client-secret>
# Leave unset for the "common" endpoint (personal + work/school accounts).
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Test-only Credentials provider. Never enable outside local e2e runs.
AUTH_TEST_MODE=false

# --- Extractor ---
EXTRACTOR_URL=http://localhost:8000
# Generate with: openssl rand -hex 32
EXTRACTOR_SHARED_SECRET=change-me-generate-with-openssl

# --- Logging ---
LOG_LEVEL=info
